# AirWise Backend Configuration
# Copy this file to .env for local development. On Render, set these as Environment Variables.

APP_NAME=AirWise API
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated allowed frontend origins for CORS (e.g. https://airwise.vercel.app,http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional single frontend URL and/or regex for Vercel preview deployments (e.g. https://.*\.vercel\.app)
FRONTEND_URL=
CORS_ORIGIN_REGEX=

# Open-Meteo Public APIs (no API key required)
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
AIR_QUALITY_CACHE_TTL_SECONDS=600
AIR_QUALITY_STALE_WARNING_SECONDS=300
AIR_QUALITY_OBSERVATION_STALE_MINUTES=180
HTTP_TIMEOUT_SECONDS=10.0

# Google Gemini API (used by AirWise AI Assistant & Indoor Air Guide)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25.0
