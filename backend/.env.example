# AirWise Backend Configuration
# Copy this file to .env and fill in your secrets locally. Never commit .env.

APP_NAME=AirWise API
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Meteo Public APIs (no API key required)
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
AIR_QUALITY_CACHE_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=10.0

# Google Gemini API (used by AI Assistant in upcoming milestone)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
